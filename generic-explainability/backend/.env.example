# =============================================================================
# Generic Explainability App — Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# ----------------------------------------------------------------------------
# Data source: "datarobot" (default) or "csv"
# ----------------------------------------------------------------------------
DATA_SOURCE=datarobot

# --- CSV mode (DATA_SOURCE=csv) ---
# CSV_PATH=data/scored_population.csv
# TRAINING_CSV_PATH=data/training_with_labels.csv

# --- DataRobot mode (DATA_SOURCE=datarobot) ---
DATAROBOT_API_TOKEN=your_token_here
DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2

# Scoring pipeline:
#   Option A — Deployment (preferred): runs a BatchPredictionJob via the
#     deployment. The deployment must have SHAP prediction explanations enabled.
#   Option B — Project + Model (fallback): used only when DEPLOYMENT_ID is not
#     set. Uploads the scoring dataset to the project, requests predictions,
#     and initialises Prediction Explanations.
DEPLOYMENT_ID=your_deployment_id        # preferred — set this to use Option A

# PROJECT_ID=your_project_id            # fallback Option B
# MODEL_ID=your_model_id                # fallback Option B

SCORING_DATASET_ID=your_scoring_dataset_id
# TRAINING_DATASET_ID=your_training_dataset_id  # optional

# ----------------------------------------------------------------------------
# Column configuration
# ----------------------------------------------------------------------------
ROW_ID_COL=id
# PREDICTION_COL=target_PREDICTION    # auto-detected if not set
# OUTCOME_COL=target                  # binary 0/1 column in training data
MAX_EXPLANATIONS=4

# ----------------------------------------------------------------------------
# Application metadata
# ----------------------------------------------------------------------------
APP_TITLE=Prediction Explainability
APP_SUBTITLE=

# ----------------------------------------------------------------------------
# Tuning (optional — defaults shown)
# ----------------------------------------------------------------------------
# COHORT_WARNING_MIN_ROWS=30
# TOP_FEATURES_PER_GROUP=5
# SCORE_HISTOGRAM_BINS=20
# NARRATIVE_MAX_TOKENS=700
# NARRATIVE_GROUPS_IN_PROMPT=6
# NARRATIVE_FEATURES_PER_GROUP=2

# ----------------------------------------------------------------------------
# LLM provider — configure ONE or MORE; the app will show available providers
# (at least one required for AI Narrative)
# ----------------------------------------------------------------------------

# --- Option 1: DataRobot LLM Gateway (recommended — uses DR API token above) ---
# Route: {endpoint}/genai/llmgw/chat/completions
# Model IDs: Chat model ID column from docs.datarobot.com/en/docs/reference/gen-ai-ref/llm-availability.html
# DR_GATEWAY_MODEL=azure/gpt-4o-mini
# Other examples:
#   azure/gpt-4o-2024-11-20
#   anthropic/claude-sonnet-4-6
#   vertex_ai/gemini-2.0-flash-001
#   bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Option 2: DataRobot deployed TextGen model ---
# DR_LLM_DEPLOYMENT_ID=your_textgen_deployment_id_here

# --- Option 3: Azure OpenAI ---
# AZURE_OPENAI_API_KEY=your_azure_key_here
# AZURE_OPENAI_API_BASE=https://your-instance.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# --- Option 4: Anthropic (direct) ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6
