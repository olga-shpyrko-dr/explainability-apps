# =============================================================================
# Manufacturing — Remaining Useful Life (RUL) — example .env
# Regression / numeric-target example (companion to .env.fraud-example, which
# is binary classification). See docs/examples.md for full write-up.
# Copy to backend/.env to activate.
# =============================================================================

# ---------------------------------------------------------------------------
# Data source — self-contained CSV mode. The scoring CSV already contains
# real DataRobot SHAP prediction explanations (EXPLANATION_N_* columns,
# additivity-verified: SHAP_BASE_VALUE + strengths + SHAP_REMAINING_TOTAL ==
# prediction to ~1e-10). No live DataRobot connection is needed to run this
# example.
# ---------------------------------------------------------------------------
# NOTE: all launch scripts (start-app.sh, start-codespace.sh, start-preview.sh)
# `cd backend` before starting uvicorn, so relative paths here resolve against
# backend/, not the repo root — hence "../data/..." rather than "data/...".
DATA_SOURCE=csv
CSV_PATH=../data/manufacturing_rul_scoring_sample.csv
TRAINING_CSV_PATH=../data/manufacturing_rul_training_sample.csv

# ---------------------------------------------------------------------------
# Column config
# ---------------------------------------------------------------------------
ROW_ID_COL=reading_id
# PREDICTION_COL auto-detects to rul_days_PREDICTION (only one *_PREDICTION column present)
# OUTCOME_COL intentionally left unset — see docs/examples.md "Known limitation":
# narrative.py formats outcome_rate as a percentage, which breaks for a
# continuous target. The true holdout value is carried instead as a plain
# reference column, actual_rul_days_holdout (see profile_config.json).
MAX_EXPLANATIONS=4

# ---------------------------------------------------------------------------
# App metadata
# ---------------------------------------------------------------------------
APP_TITLE=Predictive Maintenance — Remaining Useful Life Explainability
APP_SUBTITLE=Synthetic Caterpillar-style fleet telemetry · regression demo

# ---------------------------------------------------------------------------
# Provenance (informational only — not required in CSV mode).
# Trained fresh via Quick Autopilot on this DataRobot account from
# ../manufacturing_rul_source/training_data.csv (30k-row sample, asset_id
# excluded from the feature list to avoid identity leakage). See
# ../manufacturing_rul_source/README.md to retrain or regenerate samples.
# To switch this example to live DataRobot mode instead of CSV mode, set
# DATA_SOURCE=datarobot, DATAROBOT_API_TOKEN=..., and DEPLOYMENT_ID below,
# plus SCORING_DATASET_ID (upload data/manufacturing_rul_scoring_sample.csv
# to the AI Catalog first).
# ---------------------------------------------------------------------------
# DATAROBOT_API_TOKEN=your_token_here
# DATAROBOT_ENDPOINT=https://app.datarobot.com/api/v2
# PROJECT_ID=6a7488275a589c879326e74d
# MODEL_ID=6a748a955bd1af802e86f383            # LightGBM Regressor w/ Early Stopping, RMSE 4.09
# DEPLOYMENT_ID=6a748b20ddc31eeea5d9c1a1        # "Manufacturing RUL Explainability Demo (synthetic)"
# SCORING_DATASET_ID=your_ai_catalog_dataset_id_here

# ---------------------------------------------------------------------------
# Tuning (safe to leave at defaults)
# ---------------------------------------------------------------------------
# COHORT_WARNING_MIN_ROWS=30
# TOP_FEATURES_PER_GROUP=5
# SCORE_HISTOGRAM_BINS=20
# NARRATIVE_MAX_TOKENS=700
# NARRATIVE_GROUPS_IN_PROMPT=6
# NARRATIVE_FEATURES_PER_GROUP=2

# ---------------------------------------------------------------------------
# LLM provider — configure ONE or MORE; the app will show available providers
# (at least one required for AI Narrative)
# ---------------------------------------------------------------------------

# --- Option 1: DataRobot LLM Gateway (recommended — uses DR API token above) ---
# DR_GATEWAY_MODEL=azure/gpt-4o-mini
# Other examples:
#   azure/gpt-4o-2024-11-20
#   anthropic/claude-sonnet-4-6
#   vertex_ai/gemini-2.0-flash-001
#   bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0

# --- Option 2: DataRobot deployed TextGen model ---
# DR_LLM_DEPLOYMENT_ID=your_textgen_deployment_id_here

# --- Option 3: Azure OpenAI ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_BASE=
# AZURE_OPENAI_API_VERSION=2024-02-01
# AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Option 4: Anthropic (direct) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
